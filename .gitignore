# ===== 安全：API 密钥与配置 =====
# config.yml 包含个人 API Key，禁止提交；请使用 config.example.yml 作为模板
config.yml
*.key
.env

# ===== Python 缓存 / 编译产物 =====
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

